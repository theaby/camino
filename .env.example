# Optional override of the committed camino-ce661 web config.
# Production builds already include that project. A complete set of the four
# required lines below replaces it. Blank lines do not.
#
# Local file: copy this to .env.local
# GitHub Pages: repository Settings → Secrets and variables → Actions → Variables

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true only when running against the local emulators. Never set this on Pages.
# VITE_FIREBASE_USE_EMULATOR=true
