{
  "name": "camino",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-camino \"vitest run --config vitest.emulator.config.ts\"",
    "validate": "vitest run src/data/placement.test.ts",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-camino",
    "dev:emulator": "VITE_FIREBASE_API_KEY=demo-api-key VITE_FIREBASE_AUTH_DOMAIN=127.0.0.1 VITE_FIREBASE_PROJECT_ID=demo-camino VITE_FIREBASE_APP_ID=1:0:web:demo VITE_FIREBASE_USE_EMULATOR=true vite --host 127.0.0.1 --port 5173"
  },
  "dependencies": {
    "@fontsource/literata": "^5.2.8",
    "@fontsource/nunito": "^5.2.7",
    "firebase": "^12.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "firebase-tools": "^15.34.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.2.4"
  }
}
